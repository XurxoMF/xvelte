{
	"name": "xvelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"paraglide:translate": "inlang machine translate --project rustory.inlang"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/qrcode-generator": "0.0.16",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@floating-ui/dom": "1.7.4",
		"@internationalized/date": "^3.12.3",
		"@shikijs/langs": "4.0.2",
		"@shikijs/themes": "4.0.2",
		"@tabler/icons-svelte": "^3.46.0",
		"@tanstack/svelte-table": "^9.1.2",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "1.6.15",
		"embla-carousel-svelte": "^8.6.0",
		"gridstack": "^13.2.0",
		"layerchart": "^2.1.0",
		"libphonenumber-js": "1.12.40",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"qrcode-generator": "2.0.4",
		"runed": "0.37.1",
		"shiki": "4.0.2",
		"svelte-dnd-action": "^0.9.69",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"vaul-svelte": "^0.3.2"
	}
}
