{
	"name": "xvelte",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:tauri": "vite build --mode tauri",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"paraglide:translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/cli": "^3.6.0",
		"@inlang/paraglide-js": "^2.29.3",
		"@shadcn-svelte/primitives": "^0.0.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24.19.2",
		"@types/qrcode-generator": "0.0.16",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@floating-ui/dom": "1.7.4",
		"@internationalized/date": "^3.12.4",
		"@tabler/icons-svelte": "^3.51.0",
		"@tanstack/svelte-table": "^9.3.1",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-fs": "~2",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"country-flag-icons": "1.6.15",
		"embla-carousel-svelte": "^8.6.0",
		"github-slugger": "^2.0.0",
		"gridstack": "^13.3.0",
		"gsap": "^3.15.1",
		"hast-util-from-html": "^2.1.0",
		"hast-util-sanitize": "^5.0.2",
		"hast-util-to-html": "^9.0.6",
		"layerchart": "^2.10.0",
		"libphonenumber-js": "1.12.40",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm": "^3.1.0",
		"micromark-extension-gfm": "^3.0.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"qrcode-generator": "2.0.4",
		"runed": "0.37.1",
		"shiki": "4.0.2",
		"svelte-dnd-action": "^0.9.80",
		"svelte-sonner": "^1.2.3",
